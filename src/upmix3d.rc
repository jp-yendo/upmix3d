// Windows version information of libupmix3d_plugin.dll.
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION UPMIX3D_VERSION_MAJOR,UPMIX3D_VERSION_MINOR,UPMIX3D_VERSION_PATCH,0
 PRODUCTVERSION UPMIX3D_VERSION_MAJOR,UPMIX3D_VERSION_MINOR,UPMIX3D_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "upmix3d spatial upmix output for VLC"
            VALUE "FileVersion", UPMIX3D_VERSION_TEXT
            VALUE "InternalName", "upmix3d"
            VALUE "OriginalFilename", "libupmix3d_plugin.dll"
            VALUE "ProductName", "upmix3d"
            VALUE "ProductVersion", UPMIX3D_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
